#
# Docker: project variables
#

COMPOSE_PROJECT_NAME=ristopilot-tenant
UID=www-data
CODE_FOLDER=code

# Database
DATABASE_IMAGE_VERSION=latest
DATABASE_HOST=ristopilot-tenant_database
DATABASE_PORT_HOST=33060
DATABASE_PORT_CONTAINER=3306
DATABASE_ROOT_PASSWORD=root
DATABASE_USER=test
DATABASE_PASSWORD=test
DATABASE_DATABASE=ristopilotcrm
DATABASE_HC_INTERVAL=10s
DATABASE_HC_TIMEOUT=10s
DATABASE_HC_RETRIES=3
DATABASE_HC_START_PERIOD=3s

# database_web_ui
DATABASE_WEB_UI_IMAGE_VERSION=5.1.3
DATABASE_WEB_UI_PORT_HOST=11180
DATABASE_WEB_UI_PORT_CONTAINER=80
DATABASE_WEB_UI_HC_INTERVAL=10s
DATABASE_WEB_UI_HC_TIMEOUT=10s
DATABASE_WEB_UI_HC_RETRIES=3
DATABASE_WEB_UI_HC_START_PERIOD=3s

# redis
REDIS_CLIENT=phpredis
REDIS_HOST=ristopilot-tenant_redis
REDIS_PASSWORD=null
REDIS_PORT=6379