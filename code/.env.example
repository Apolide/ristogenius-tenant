APP_NAME=TestRestaurant
APP_ENV=local
APP_KEY=base64:my_secret_key
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8002

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Laravel gira nel container, questi valori vengono già forniti da Docker.
# DB_CONNECTION=mysql
# DB_HOST=ristopilot-tenant_database
# DB_PORT=3306
# DB_DATABASE=app
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local


# QUEUE_CONNECTION=database
# CACHE_STORE=database

# Temporarily disable queue DB usage
# stops the worker from hammering MySQL while you get everything else working.
## QUEUE_CONNECTION=database
## CACHE_STORE=database
# QUEUE_CONNECTION=sync
# CACHE_STORE=file
# Redis handles asynchronous application and messaging queues.
QUEUE_CONNECTION=redis
MESSAGE_TRANSPORT=redis
MESSAGE_QUEUE_CONNECTION=redis
MESSAGE_DISPATCH_QUEUE=messages-dispatch
MESSAGE_EMAIL_QUEUE=messages-email
MESSAGE_TELEGRAM_QUEUE=messages-telegram
MESSAGE_WHATSAPP_QUEUE=messages-whatsapp
MESSAGE_SMS_QUEUE=messages-sms
CACHE_STORE=file

CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=ristopilot-tenant_redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# MAIL_MAILER=log
MAIL_MAILER=smtp
MAIL_HOST=ristopilot-tenant_mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

OPSBOT_SQLITE_PATH=/var/www/html/storage/data/ops.sqlite
# OPSBOT_SQLITE_PATH=/var/www/html/storage/data/chroma.sqlite3

TENANT_NAME="Test Restaurant"
TENANT_SLUG=test-restaurant
TENANT_ID=9ee89e25-3403-4da0-951c-3bd8e97a5946
TENANT_LANGUAGES=de,it,en
TENANT_CUSTOMER_LANGUAGES=it,en,de
MARKETING_FORMS_DATEPICKER=flatpickr
# MARKETING_FORMS_DATEPICKER=native # native html5 datepicker

# Default public marketing form style. Per-form UI settings may override these values.
TENANT_FORM_STYLE_PAGE_BACKGROUND="#f3f4f6"
TENANT_FORM_STYLE_FORM_BACKGROUND="#ffffff"
TENANT_FORM_STYLE_TEXT_COLOR="#374151"
TENANT_FORM_STYLE_HEADING_COLOR="#111827"
TENANT_FORM_STYLE_LABEL_COLOR="#374151"
TENANT_FORM_STYLE_LINK_COLOR="#2563eb"
TENANT_FORM_STYLE_INPUT_BACKGROUND="#ffffff"
TENANT_FORM_STYLE_INPUT_TEXT_COLOR="#111827"
TENANT_FORM_STYLE_INPUT_BORDER_COLOR="#d1d5db"
TENANT_FORM_STYLE_CONTROL_ACCENT_COLOR="#2563eb"
TENANT_FORM_STYLE_BUTTON_BACKGROUND="#2563eb"
TENANT_FORM_STYLE_BUTTON_TEXT_COLOR="#ffffff"
TENANT_FORM_STYLE_HEADER_BACKGROUND="#ffffff"
TENANT_FORM_STYLE_HEADER_TEXT_COLOR="#111827"
TENANT_FORM_STYLE_FOOTER_BACKGROUND="#ffffff"
TENANT_FORM_STYLE_FOOTER_TEXT_COLOR="#6b7280"
TENANT_FORM_STYLE_CONTENT_MAX_WIDTH=56rem
TENANT_FORM_STYLE_FORM_RADIUS=0.75rem
TENANT_FORM_STYLE_HEADER_HEIGHT=4rem
TENANT_FORM_STYLE_FOOTER_HEIGHT=3.5rem
TENANT_FORM_STYLE_BACKGROUND_OVERLAY=35
TENANT_FORM_STYLE_BACKGROUND_POSITION="center center"
TENANT_FORM_STYLE_IMAGE_MIN_WIDTH=1600
TENANT_FORM_STYLE_IMAGE_MIN_HEIGHT=900
TENANT_FORM_STYLE_IMAGE_MAX_SIZE_KB=5120
TENANT_FORM_STYLE_IMAGE_RECOMMENDED_WIDTH=1920
TENANT_FORM_STYLE_IMAGE_RECOMMENDED_HEIGHT=1080
